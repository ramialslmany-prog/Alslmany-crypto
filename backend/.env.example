# Copy to backend/.env and edit. Never commit the filled-in file.

ENVIRONMENT=development
DEBUG=false

# --- database --------------------------------------------------------------
# PostgreSQL is the production target:
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/alslmany
# SQLite needs no server and is fine for a local run and for the test suite:
DATABASE_URL=sqlite+aiosqlite:///./alslmany.db
DATABASE_ECHO=false

# --- market data -----------------------------------------------------------
# Tried in order; the first that answers wins.
MARKET_DATA_PROVIDERS=binance,okx
MARKET_DATA_TIMEOUT_SECONDS=10
MARKET_DATA_MAX_RETRIES=3
MARKET_DATA_BACKOFF_SECONDS=0.5

# A quote older than this is refused rather than served.
MAX_QUOTE_AGE_SECONDS=90

TICKER_CACHE_SECONDS=5
CANDLE_CACHE_SECONDS=15
ORDERBOOK_CACHE_SECONDS=2

SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT

# Public endpoints need no key. Present for providers that do.
MARKET_DATA_API_KEY=

# --- paper trading ---------------------------------------------------------
# Virtual money. This platform never places a real order.
INITIAL_BALANCE_USDT=10000
RISK_PER_TRADE_PCT=1
MAX_OPEN_TRADES=5
MAX_DAILY_LOSS_PCT=3
MAX_DRAWDOWN_PCT=10

# --- AI (Stage 4) ----------------------------------------------------------
# Server-side only. This value must never reach the browser.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5

# --- http ------------------------------------------------------------------
CORS_ORIGINS=*
