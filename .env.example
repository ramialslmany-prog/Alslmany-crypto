# ═══════════════════════════════════════════════════════════════════════════
#  إعدادات منصّة السلماني للتحليل
#  انسخ هذا الملف إلى .env.local ثم عدّل ما تحتاجه.
#  كل شيء هنا اختياري — البوت يعمل بالمصادر المجانية دون أي مفتاح.
# ═══════════════════════════════════════════════════════════════════════════

# ── مصدر بيانات السوق ──────────────────────────────────────────────────────
# تبديل المنصّة بالكامل من هذا السطر وحده: binance | bybit | okx
MARKET_EXCHANGE=binance
QUOTE_ASSET=USDT

# عناوين بديلة — استخدمها إذا حُجبت المنصّة في بلدك.
# مرآة بايننس التي لا تتطلّب مفتاحاً وتتجاوز بعض الحجب الجغرافي:
# BINANCE_SPOT_BASE=https://data-api.binance.vision
# BINANCE_FUTURES_BASE=https://fapi.binance.com

# ── العملات المتابَعة ──────────────────────────────────────────────────────
# اتركها فارغة ليكتشف البوت العملات تلقائياً حسب حجم التداول الفعلي.
# WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
UNIVERSE_MAX_SYMBOLS=120
MIN_LISTING_AGE_DAYS=90

# ── إدارة المخاطر — حدود صارمة لا اقتراحات ────────────────────────────────
RISK_PER_TRADE_PCT=1          # مخاطرة كل صفقة من رأس المال
MAX_OPEN_POSITIONS=6          # أقصى عدد مراكز مفتوحة
MAX_CORRELATED_POSITIONS=3    # أقصى مراكز مترابطة في نفس الاتجاه
CORRELATION_THRESHOLD=0.8     # الحدّ الذي يُعتبر عنده مركزان مترابطين
DAILY_LOSS_HALT_PCT=3         # خسارة يومية توقف البوت
DAILY_HALT_HOURS=24           # مدة التوقف بعدها
MAX_DRAWDOWN_HALT_PCT=15      # تراجع من الذروة يوقف البوت حتى تشغيل يدوي
PAPER_STARTING_EQUITY=10000   # رأس المال الافتراضي

# ── عتبات القرار — فلاتر النقض النهائية ───────────────────────────────────
MIN_FINAL_SCORE=60            # أقل نتيجة مقبولة لفتح صفقة
MIN_RISK_REWARD=1.8           # أقل نسبة عائد للمخاطرة
MAX_BTC_CORRELATION_FOR_INDEPENDENCE=0.85  # فوقها التحليل الفني ليس مستقلاً

# ═══════════════════════════════════════════════════════════════════════════
#  المصادر المدفوعة — معطّلة تماماً بدون مفتاح
#  بدون المفتاح تُسجَّل المرحلة «غير متاحة»، وتنخفض الثقة بنسبة معلومة،
#  ويظهر ذلك صراحةً في الموقع. لا تُخترع أي قيمة أبداً.
# ═══════════════════════════════════════════════════════════════════════════
# CRYPTOQUANT_API_KEY=        # بيانات السلسلة: تدفّقات المنصّات والاحتياطيات
# COINGLASS_API_KEY=          # مشتقّات مجمّعة عبر كل المنصّات
# LUNARCRUSH_API_KEY=         # المشاعر الاجتماعية
# COINGECKO_API_KEY=          # مفتاح تجريبي مجاني يرفع حدّ الطلبات فقط

# ── إشعارات تيليجرام ───────────────────────────────────────────────────────
# أنشئ بوتاً عبر @BotFather ثم اضغط Start عليه مرة واحدة.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_QUIET_HOURS=23:00-07:00   # بتوقيت UTC
TELEGRAM_MAX_PER_HOUR=6

# ═══════════════════════════════════════════════════════════════════════════
#  التداول الحقيقي — معطّل عمداً. لا تفعّله قبل مراجعة نتائج التداول الورقي.
#  استخدم مفاتيح بلا صلاحية سحب إطلاقاً.
# ═══════════════════════════════════════════════════════════════════════════
LIVE_TRADING_ENABLED=false
# LIVE_EXCHANGE_API_KEY=
# LIVE_EXCHANGE_API_SECRET=

# ── التخزين والتشغيل ───────────────────────────────────────────────────────
DATA_DIR=./data
DB_FILE=alslmany.db
ARCHIVE_DIR=archive
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=3
LOG_LEVEL=info
# LOG_FORMAT=json             # فعّلها عند إرسال السجلّات إلى نظام مراقبة
